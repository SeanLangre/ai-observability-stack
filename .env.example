# Copy to .env and adjust. run.sh sources it; docker compose reads it too.

# llama.cpp checkout containing build/bin/llama-server
LLAMA_CPP_DIR=/path/to/llama.cpp
# GGUF model to serve
MODEL_PATH=~/models/unsloth/qwen/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf

# Grafana admin password (only applied on Grafana's first start)
#GRAFANA_ADMIN_PASSWORD=
